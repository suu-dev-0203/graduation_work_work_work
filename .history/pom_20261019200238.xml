<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://apache.org" xmlns:xsi="http://w3.org"
	xsi:schemaLocation="http://apache.org https://apache.org">
	<modelVersion>4.0.0</modelVersion>

	<!-- 1. このアプリが「Spring Boot」の仕組み（Webアプリの土台）を使うための基本ルール -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.5</version>
		<relativePath/>
	</parent>

	<!-- 2. あなたの新しいアプリの名前（ネット上の住所）の設定 -->
	<groupId>com.example</groupId>
	<artifactId>graduation_work_work_work</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>graduation_work_work_work</name>
	<description>JAVA学習ゲームアプリを復習し理解するためもう一度セキュリティを意識してアプリ制作手順を作って学びます。</description>

	<properties>
		<java.version>17</java.version>
	</properties>

		<dependencies>
		<!-- 3. Webアプリ（どこつぶのような通信機能）を動かすためのコア部品 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- 画面（HTML）を表示するためのタイムリーフ部品 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<!-- 4. データベース（JPA）を操作するための部品 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- 5. データを保存する倉庫（H2 Database）そのものの部品 -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- 6. テスト（プログラムが正しく動くか自動チェック）を行うための部品 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
